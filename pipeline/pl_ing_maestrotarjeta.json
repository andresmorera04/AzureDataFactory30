{
	"name": "pl_ing_maestrotarjeta",
	"properties": {
		"activities": [
			{
				"name": "cd_IngestaDatosMaestroTarjeta",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OracleSource",
						"oracleReaderQuery": "SELECT \r\n    Tipo \r\n    ,SUBSTR(NumeroTarjeta, 1, 8) || '****' || SUBSTR(NumeroTarjeta, -4) AS NUMEROTARJETA\r\n    ,('' || standard_hash(\r\n            UTL_I18N.STRING_TO_RAW(\r\n                TO_CHAR(NumeroTarjeta), 'AL32UTF8'\r\n                )\r\n                , 'SHA512'\r\n            )\r\n    ) AS HashLlaveNegocio\r\nFROM \r\n    SYSTEM.MAESTROTARJETAS;",
						"partitionOption": "None",
						"convertDecimalToInteger": false,
						"queryTimeout": "00:25:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"parallelCopies": 1,
					"dataIntegrationUnits": 4,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_ora_system_maestrotarjeta",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adlg2_system_maestrotarjeta",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "DominioTemporalDesarrollo/MaestroTarjetas"
		},
		"annotations": []
	}
}